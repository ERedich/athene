{
  "name": "athene-cmms",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "mobile"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend,mobile -c blue,green,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\" \"npm run web -w mobile\"",
    "dev:mobile": "npm run web -w mobile",
    "build": "npm run build -w backend && npm run build -w frontend",
    "migrate": "npm run migrate -w backend",
    "athene:reindex": "npm run athene:reindex-embeddings -w backend",
    "athene:reindex-embeddings": "npm run athene:reindex-embeddings -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "expo-router": "~6.0.23",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1"
  }
}
