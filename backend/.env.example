OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set to 0 to disable automatic embedding ingest on CRUD (backfill script still requires OPENAI_API_KEY)
ATHENE_EMBEDDING_ENABLED=1
# Optional: max characters per embedding chunk (default 3500)
# ATHENE_CHUNK_MAX_CHARS=3500
